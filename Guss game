#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int target, guess = -1, attempts = 0;

    srand(time(0));
    target = rand() % 50 + 1;

    printf("Guess the number (1 to 50):\n");

    while (guess != target) {
        printf("Enter your guess: ");
        scanf("%d", &guess);

        attempts++;

        if (guess > target) {
            printf("Too high!\n");
        } else if (guess < target) {
            printf("Too low!\n");
        } else {
            printf("Correct! You guessed it in %d attempts.\n", attempts);
        }
    }

    return 0;
}
